{
  "rewrites": [
    { "source": "/img/:clave", "destination": "/api/imagenes-servir?clave=:clave" },
    { "source": "/((?!api/|img/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
