{
  "path": [
    "src",
    "api"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/components/ui/**"
  ],
  "minTokens": 70,
  "minLines": 8,
